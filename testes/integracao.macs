// Chamada antes da definição, recursão, entradas e escopo.
print(fib(10));
func fib(n: int): int {
    if (n < 2) { return n; }
    else { return fib(n - 1) + fib(n - 2); }
}

func dobro_real(n: float): float {
    return n * 2;
}

var letra: char;
var ligado: bool;
var texto: string;
var medida: float;
input(letra);
input(ligado);
input(texto);
input(medida);

if (ligado && texto == "Cafe com leite") {
    print(letra);
}
print(dobro_real(medida));
print(dobro_real(3));

var n: int = 0;
for (; n < 1; n = n + 1) {
    var n: int = 5;
    print(n);
}
print(n);
print(2 + 3 * 4);
print(!(15 % 4 != 3) || false);
